# Offline by default. Set a real key only in your ignored .env or cloud secrets.
LLM_PROVIDER=demo
LLM_MODEL=gpt-6.1-terra
OPENAI_API_KEY=
ALLOW_PAID_API=false
# local = keyword vectors; openai = semantic embeddings sent to the provider.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=text-embedding-3-small
API_TIMEOUT_SECONDS=40
MAX_OUTPUT_TOKENS=1800
DAILY_BUDGET_USD=1
# USD per million tokens; update these when changing model or published prices.
INPUT_PRICE_PER_MILLION=1
OUTPUT_PRICE_PER_MILLION=5
EMBEDDING_PRICE_PER_MILLION=0.02
SESSION_REQUESTS_PER_MINUTE=8
GLOBAL_REQUESTS_PER_MINUTE=30
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=150
# Optional absolute private storage directory; blank defaults to project/data.
DATA_DIR=
# Enable for any hosted instance and choose a strong password of at least 12 characters.
REQUIRE_PASSWORD=false
APP_PASSWORD=
